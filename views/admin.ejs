<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-indigo-500 to-purple-600 min-h-screen p-5">
    <!-- Header -->
    <header class="bg-white rounded-lg shadow-md mb-5 p-6 flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-bold text-gray-900">Admin Dashboard</h1>
            <p class="text-gray-600 text-sm mt-1">Manage users and their conversations</p>
        </div>
        <div class="inline-flex items-center gap-2 bg-indigo-500 text-white px-4 py-2 rounded-full text-xs font-semibold">
            <span>Admin:</span>
            <span id="adminEmail">Loading...</span>
        </div>
    </header>
    
    <!-- Main Container -->
    <div class="flex gap-5 max-w-7xl mx-auto h-[calc(100vh-140px)]">
        <!-- Users Panel -->
        <div class="w-80 bg-white rounded-lg shadow-md overflow-hidden flex flex-col">
            <!-- Panel Header -->
            <div class="bg-indigo-500 text-white px-6 py-4 font-semibold border-b-4 border-purple-600">
                Users
            </div>
            
            <!-- Search -->
            <div class="px-6 py-3 bg-gray-50 border-b border-gray-200">
                <input 
                    type="text" 
                    id="userSearchInput"
                    placeholder="Search by user ID..." 
                    onkeyup="searchUsers(this.value)"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                >
            </div>
            
            <!-- Users List -->
            <div class="flex-1 overflow-y-auto p-4" id="usersList">
                <div class="flex flex-col items-center justify-center h-full">
                    <svg class="w-8 h-8 animate-spin text-indigo-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="text-gray-600 text-sm">Loading users...</span>
                </div>
            </div>
        </div>
        
        <!-- Conversations Panel -->
        <div class="flex-1 bg-white rounded-lg shadow-md overflow-hidden flex flex-col">
            <!-- Panel Header -->
            <div class="bg-indigo-500 text-white px-6 py-4 font-semibold border-b-4 border-purple-600">
                Conversations
            </div>
            
            <!-- Conversations List -->
            <div class="flex-1 overflow-y-auto p-4" id="conversationsList">
                <div class="flex items-center justify-center h-full text-gray-500 text-sm">
                    Select a user to view their conversations
                </div>
            </div>
        </div>
    </div>
    
    <script>
        let selectedUserId = null;
        let currentAdminId = null;
        let allUsers = [];
        
        async function loadUsers() {
            try {
                const response = await fetch('/api/users');
                const data = await response.json();
                
                if (!data.users || data.users.length === 0) {
                    document.getElementById('usersList').innerHTML = '<div class="flex items-center justify-center h-full text-gray-500 text-sm">No users found</div>';
                    return;
                }
                
                allUsers = data.users;
                displayUsers(allUsers);
            } catch (error) {
                document.getElementById('usersList').innerHTML = `<div class="flex items-center justify-center h-full text-gray-500 text-sm">Error: ${error.message}</div>`;
            }
        }
        
        function displayUsers(users) {
            const usersList = document.getElementById('usersList');
            if (!users || users.length === 0) {
                usersList.innerHTML = '<div class="flex items-center justify-center h-full text-gray-500 text-sm">No users found</div>';
                return;
            }
            
            usersList.innerHTML = users.map(user => `
                <div class="user-item mb-2 p-3 bg-gray-50 hover:bg-gray-100 border-l-4 border-indigo-400 hover:border-indigo-600 rounded cursor-pointer transition-colors" onclick="selectUser(${user.id})">
                    <div class="font-semibold text-gray-900 text-sm">User #${user.id}</div>
                    <div class="text-gray-600 text-xs mt-1">Created: ${new Date(user.created_at).toLocaleDateString()}</div>
                </div>
            `).join('');
        }
        
        function searchUsers(searchTerm) {
            if (!searchTerm.trim()) {
                displayUsers(allUsers);
                return;
            }
            
            const filtered = allUsers.filter(user => 
                user.id.toString().includes(searchTerm.trim())
            );
            
            displayUsers(filtered);
        }
        
        async function selectUser(userId) {
            selectedUserId = userId;
            
            // Update UI
            document.querySelectorAll('.user-item').forEach(item => {
                item.classList.remove('bg-indigo-500', 'text-white', 'border-indigo-700');
                item.classList.add('bg-gray-50', 'text-gray-900', 'border-indigo-400');
            });
            event.target.closest('.user-item').classList.add('bg-indigo-500', 'text-white', 'border-indigo-700');
            event.target.closest('.user-item').classList.remove('bg-gray-50', 'text-gray-900', 'border-indigo-400');
            
            // Load conversations
            await loadConversations(userId);
        }
        
        async function loadConversations(userId) {
            try {
                const conversationsList = document.getElementById('conversationsList');
                conversationsList.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-full">
                        <svg class="w-8 h-8 animate-spin text-indigo-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span class="text-gray-600 text-sm">Loading conversations...</span>
                    </div>
                `;
                
                const response = await fetch(`/api/users/${userId}/conversations`);
                const data = await response.json();
                
                console.log('Conversations response:', data);
                
                if (!data.conversations || data.conversations.length === 0) {
                    conversationsList.innerHTML = '<div class="flex items-center justify-center h-full text-gray-500 text-sm">No conversations found</div>';
                    return;
                }
                
                conversationsList.innerHTML = data.conversations.map(convo => `
                    <div class="mb-3 p-4 bg-gray-50 hover:bg-gray-100 border border-gray-200 hover:border-indigo-300 rounded-lg transition-colors flex justify-between items-center gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="font-semibold text-indigo-600 hover:text-indigo-700 hover:underline cursor-pointer text-sm" onclick="viewConversation(${convo.id})">
                                Conversation #${convo.id}
                            </div>
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <label class="text-xs font-semibold text-gray-700">Score:</label>
                            <input 
                                type="number" 
                                min="0" 
                                max="10" 
                                value="${convo.score || ''}" 
                                placeholder="0-10" 
                                data-convo-id="${convo.id}"
                                class="w-14 px-2 py-1 border border-gray-300 rounded text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                            >
                            <button 
                                class="px-3 py-1 bg-indigo-500 text-white text-xs font-semibold rounded hover:bg-indigo-600 transition-colors active:scale-95"
                                onclick="saveScore(${convo.id}, this)"
                            >
                                Save
                            </button>
                        </div>
                    </div>
                `).join('');
            } catch (error) {
                console.error('Error loading conversations:', error);
                document.getElementById('conversationsList').innerHTML = `<div class="flex items-center justify-center h-full text-gray-500 text-sm">Error: ${error.message}</div>`;
            }
        }
        
        async function saveScore(convoId, button) {
            try {
                const input = document.querySelector(`input[data-convo-id="${convoId}"]`);
                const score = parseInt(input.value);
                
                if (isNaN(score) || score < 0 || score > 10) {
                    alert('Please enter a score between 0 and 10');
                    return;
                }
                
                button.disabled = true;
                button.textContent = 'Saving...';
                
                const response = await fetch(`/api/conversations/${convoId}/score`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ score, adminId: currentAdminId })
                });
                
                const result = await response.json();
                
                if (!response.ok) {
                    alert('Error saving score: ' + result.error);
                    button.disabled = false;
                    button.textContent = 'Save';
                    return;
                }
                
                button.textContent = 'Saved!';
                button.classList.add('bg-green-500', 'hover:bg-green-600');
                button.classList.remove('bg-indigo-500', 'hover:bg-indigo-600');
                
                setTimeout(() => {
                    button.textContent = 'Save';
                    button.disabled = false;
                    button.classList.remove('bg-green-500', 'hover:bg-green-600');
                    button.classList.add('bg-indigo-500', 'hover:bg-indigo-600');
                }, 2000);
            } catch (error) {
                console.error('Error saving score:', error);
                alert('Error saving score: ' + error.message);
                button.textContent = 'Save';
                button.disabled = false;
            }
        }
        
        function viewConversation(convoId) {
            window.open(`/conversation/${convoId}`, '_blank');
        }
        
        async function loadAdminInfo() {
            try {
                const response = await fetch('/api/admin-info');
                const data = await response.json();
                document.getElementById('adminEmail').textContent = data.admin.email;
                currentAdminId = data.admin.id;
            } catch (error) {
                document.getElementById('adminEmail').textContent = 'Admin';
            }
        }
        
        // Initialize
        loadAdminInfo();
        loadUsers();
    </script>
</body>
</html>
    
    <script>
        let selectedUserId = null;
        let currentAdminId = null;
        let allUsers = [];
        
        async function loadUsers() {
            try {
                const response = await fetch('/api/users');
                const data = await response.json();
                
                if (!data.users || data.users.length === 0) {
                    document.getElementById('usersList').innerHTML = '<div class="no-selection">No users found</div>';
                    return;
                }
                
                allUsers = data.users;
                displayUsers(allUsers);
            } catch (error) {
                document.getElementById('usersList').innerHTML = `<div class="no-selection">Error loading users: ${error.message}</div>`;
            }
        }
        
        function displayUsers(users) {
            const usersList = document.getElementById('usersList');
            if (!users || users.length === 0) {
                usersList.innerHTML = '<div class="flex items-center justify-center h-full text-gray-600 italic">No users found</div>';
                return;
            }
            
            usersList.innerHTML = users.map(user => `
                <div class="user-item-element p-3 mb-2 bg-gray-100 border-l-4 border-indigo-500 rounded cursor-pointer transition-all hover:bg-gray-300 hover:border-l-purple-600 hover:translate-x-1" onclick="selectUser(${user.id})">
                    <div class="font-semibold text-sm">User #${user.id}</div>
                    <div class="text-xs opacity-70 mt-1">Created: ${new Date(user.created_at).toLocaleDateString()}</div>
                </div>
            `).join('');
        }
        
        function searchUsers(searchTerm) {
            if (!searchTerm.trim()) {
                displayUsers(allUsers);
                return;
            }
            
            const filtered = allUsers.filter(user => 
                user.id.toString().includes(searchTerm.trim())
            );
            
            displayUsers(filtered);
        }
        
        async function selectUser(userId) {
            selectedUserId = userId;
            
            // Update UI
            document.querySelectorAll('.user-item-element').forEach(item => {
                item.classList.remove('bg-indigo-500', 'text-white', 'border-l-purple-600');
                item.classList.add('bg-gray-100', 'text-gray-900', 'border-l-indigo-500');
            });
            event.target.closest('.user-item-element').classList.add('bg-indigo-500', 'text-white', 'border-l-purple-600');
            event.target.closest('.user-item-element').classList.remove('bg-gray-100', 'text-gray-900', 'border-l-indigo-500');
            
            // Load conversations
            await loadConversations(userId);
        }
        
        async function loadConversations(userId) {
            try {
                const conversationsList = document.getElementById('conversationsList');
                conversationsList.innerHTML = '<div class="flex items-center justify-center h-full text-gray-600"><div class="flex items-center"><div class="w-8 h-8 border-4 border-gray-300 border-t-indigo-500 rounded-full spinner mr-3"></div>Loading conversations...</div></div>';
                
                const response = await fetch(`/api/users/${userId}/conversations`);
                const data = await response.json();
                
                console.log('Conversations response:', data);
                
                if (!data.conversations || data.conversations.length === 0) {
                    conversationsList.innerHTML = '<div class="flex items-center justify-center h-full text-gray-600 italic">No conversations found for this user</div>';
                    return;
                }
                
                conversationsList.innerHTML = data.conversations.map(convo => `
                    <div class="p-4 mb-3 bg-gray-50 border border-gray-300 rounded-md cursor-pointer transition-all hover:bg-gray-100 hover:border-indigo-500 flex justify-between items-center">
                        <div class="flex-1">
                            <div class="font-semibold text-indigo-500 mb-1 cursor-pointer hover:underline" onclick="viewConversation(${convo.id})">Conversation #${convo.id}</div>
                        </div>
                        <div class="flex items-center gap-3 pl-4 border-l border-gray-300">
                            <span class="text-xs font-semibold text-gray-700 whitespace-nowrap">Score:</span>
                            <input type="number" class="w-12 px-2 py-1 border border-gray-300 rounded text-sm font-semibold focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" min="0" max="10" value="${convo.score || ''}" placeholder="0-10" data-convo-id="${convo.id}">
                            <button class="px-3 py-1 bg-indigo-500 text-white rounded text-xs font-semibold transition-all hover:bg-purple-600 active:scale-95" onclick="saveScore(${convo.id}, this)">Save</button>
                        </div>
                    </div>
                `).join('');
            } catch (error) {
                console.error('Error loading conversations:', error);
                document.getElementById('conversationsList').innerHTML = `<div class="flex items-center justify-center h-full text-gray-600 italic">Error loading conversations: ${error.message}</div>`;
            }
        }
        
        async function saveScore(convoId, button) {
            try {
                const input = document.querySelector(`input[data-convo-id="${convoId}"]`);
                const score = parseInt(input.value);
                
                if (isNaN(score) || score < 0 || score > 10) {
                    alert('Please enter a score between 0 and 10');
                    return;
                }
                
                button.disabled = true;
                button.textContent = 'Saving...';
                
                const response = await fetch(`/api/conversations/${convoId}/score`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ score, adminId: currentAdminId })
                });
                
                const result = await response.json();
                
                if (!response.ok) {
                    alert('Error saving score: ' + result.error);
                    return;
                }
                
                button.textContent = 'Saved!';
                setTimeout(() => {
                    button.textContent = 'Save';
                    button.disabled = false;
                }, 2000);
            } catch (error) {
                console.error('Error saving score:', error);
                alert('Error saving score: ' + error.message);
                button.textContent = 'Save';
                button.disabled = false;
            }
        }
        
        function viewConversation(convoId) {
            window.open(`/conversation/${convoId}`, '_blank');
        }
        
        async function loadAdminInfo() {
            try {
                const response = await fetch('/api/admin-info');
                const data = await response.json();
                document.getElementById('adminEmail').textContent = data.admin.email;
                currentAdminId = data.admin.id;
            } catch (error) {
                document.getElementById('adminEmail').textContent = 'Admin';
            }
        }
        
        // Initialize
        loadAdminInfo();
        loadUsers();
    </script>
</body>
</html>
